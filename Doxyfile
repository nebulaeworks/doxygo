# doxygo's own documentation, generated by doxygo. Build with "make docs";
# output goes to build/docs/html. Only settings that differ from Doxygen's
# defaults, following the C++ projects' (e.g. KORA's) configuration.

PROJECT_NAME           = doxygo
PROJECT_BRIEF          = "A Doxygen input filter for Go"
OUTPUT_DIRECTORY       = build/docs

INPUT                  = README.md .
RECURSIVE              = YES
FILE_PATTERNS          = *.go *.md
EXCLUDE                = build bin
EXCLUDE_PATTERNS       = *_test.go */testdata/*
EXTENSION_MAPPING      = go=C++
FILTER_PATTERNS        = *.go=$(DOXYGO)
USE_MDFILE_AS_MAINPAGE = README.md
TOC_INCLUDE_HEADINGS   = 5

JAVADOC_AUTOBRIEF      = YES
ALWAYS_DETAILED_SEC    = YES

# Everything is documented, parameters and results too; anything missing
# fails the build.
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
QUIET                  = YES

SOURCE_BROWSER         = YES
INLINE_SOURCES         = YES

# doxygo adds these itself, from the Go type checker.
REFERENCED_BY_RELATION = NO
REFERENCES_RELATION    = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO

GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = YES
HTML_DYNAMIC_SECTIONS  = YES
EXT_LINKS_IN_WINDOW    = YES
GENERATE_LATEX         = NO
GENERATE_TAGFILE       = build/docs/doxytags

HAVE_DOT               = YES
HIDE_UNDOC_RELATIONS   = NO
UML_LOOK               = YES
DOT_UML_DETAILS        = YES
TEMPLATE_RELATIONS     = YES
